<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/20" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">
  <!-- Enable IPTool of ETS. This hide ip settings in network tab -->
  <op:config name="%NET_IPConfigTool%" value="0" />
  <op:config name="%NET_WifiTool%" value="0" />
  <op:config name="%NET_LanMode%" value="0" />
  <op:config name="%NET_ServiceNTP%" value="1" />
  <op:config name="%NET_ServiceOTA%" value="1" />
  <op:config name="%NET_ShowMediumInfo%" value="0" />

  <!-- Prepare: Not ready to use -->
  <op:config name="%NET_ServiceHTTP%" value="0" />


  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>
          <Static>
            <ParameterTypes>
              <ParameterType Id="%AID%_PT-PLYFileSharePrefix" Name="FileSharePrefix">
                <TypeText SizeInBit="400" />
              </ParameterType>
             
            </ParameterTypes>
            <Parameters>
              <Union SizeInBit="400">
                <Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
                <!-- File share prefix -->
                <Parameter Id="%AID%_UP-%TT%00001" Name="FileSharePrefix"        ParameterType="%AID%_PT-PLYFileSharePrefix"        Offset="0"  BitOffset="0" Text="Dateifreigabe Präfix" Value="//192.168.0.1/Share/" />
                <!-- ^^^ need 50 bytes ^^^ -->
              </Union>

            </Parameters>
            <ParameterRefs>
              <!-- File share prefix -->
              <ParameterRef Id="%AID%_UP-%TT%00001_R-%TT%0000100" RefId="%AID%_UP-%TT%00001" />
            </ParameterRefs>
            <ComObjectTable>
            </ComObjectTable>
            <ComObjectRefs>
            </ComObjectRefs>
          </Static>
          <Dynamic>
            <Channel Id="%AID%_CH-%PREFIX%" Number="%PREFIX%" Name="Main" Text="Player" Icon="disc-player" HelpContext="PLY-Player">
              <ParameterBlock Id="%AID%_PB-nnn" Name="Basic" Text="Allgemein" Icon="cog-outline" HelpContext="PLY-Player">
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Player" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
              

                <ParameterSeparator Id="%AID%_PS-nnn" Text="Einstellungen" UIHint="Headline" />
               
                <!-- File share prefix -->
                <ParameterRefRef RefId="%AID%_UP-%TT%00001_R-%TT%0000100" IndentLevel="1" HelpContext="%DOC%" />
                
              </ParameterBlock>

            </Channel>
          </Dynamic>
        </ApplicationProgram>
      </ApplicationPrograms>
      <Baggages>
        <Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
        <Baggage TargetPath="" Name="Icons.zip" Id="%FILE-ICONS%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
      </Baggages>
    </Manufacturer>
  </ManufacturerData>
</KNX>